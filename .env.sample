# AI 기능은 Gemini API 키를 설정한 경우에만 ai-google 프로필을 추가합니다.
SPRING_PROFILES_ACTIVE=web,db
# SPRING_PROFILES_ACTIVE=web,db,ai-google
SERVER_PORT=8080
SESSION_COOKIE_SECURE=false

# Supabase Dashboard > Project Settings > Database에서 비밀번호를 확인한다.
# Direct Connection은 IPv6 환경이 필요할 수 있으므로 IPv4 Session Pooler를 사용한다.
SUPABASE_DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.xebtefsablyalzvzyhpt
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSL_MODE=require


SUPABASE_URL=https://xebtefsablyalzvzyhpt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=task-attachments

JPA_DDL_AUTO=none
GEMINI_API_KEY=
